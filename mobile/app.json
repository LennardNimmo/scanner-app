{
  "expo": {
    "name": "SlimBesteld",
    "slug": "slimbesteld",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "slimbesteld",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lennardnimmo.slimbesteld"
    },
    "android": {
      "package": "com.lennardnimmo.slimbesteld"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "SlimBesteld gebruikt je camera om productbarcodes te scannen.",
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "newArchEnabled": true
  }
}
