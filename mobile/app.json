{
  "expo": {
    "name": "ScanDeal",
    "slug": "scandeal-marketplace",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "scandeal",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.scandeal"
    },
    "android": {
      "package": "com.example.scandeal"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "We gebruiken je camera om barcodes te scannen."
        }
      ]
    ],
    "newArchEnabled": true
  }
}
